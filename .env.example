# --- External Gateways (Stubs / Mock Endpoints) ---
ESKIZ_EMAIL=sample@domain.uz
ESKIZ_PASSWORD=sample_password
TELEGRAM_BOT_TOKEN=0000000000:AA_SAMPLE_BOT_TOKEN_REPLACE_HERE
TELEGRAM_CHAT_ID=0000000000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
